# Aeris — secrets. gitignored, chmod 600. Never read by the browser.
# The Python server holds these; the page only ever sees text and audio bytes.

ELEVENLABS_API_KEY=

# Voice. Default is Jessica — young, warm, confident.
# Audition and switch live from the UI (gear icon) — it writes back here.
#   Jessica  cgSgspJ2msm6clMCkdW9   sweet + confident, American      <- default
#   Lily     pFZP5JQG7iQjIQuC4Bku   warm, British, steady
#   Alice    Xb7hH8MSUJpSbSDYk0k2   crisp, British, very confident
#   Matilda  XrExE9yKIg1WjnnlVkGX   soft, friendly, American
#   Sarah    EXAVITQu4vr4xnSDxMaL   gentle, low, American
#   Laura    FGY2WhTYpPnrIDTdsKH5   bright, upbeat, American
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# Voice character. 0..1 each.
ELEVENLABS_STABILITY=0.42
ELEVENLABS_SIMILARITY=0.80
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEED=1.03

# 1 = invented fixtures, safe to screen-record.  0 = your real folders.
# Read in exactly one file: agent/data.py
AERIS_DEMO=1

# Your real folders, used only when AERIS_DEMO=0. Colon-separated. Read-only.
AERIS_VAULT_ROOTS=

# Language model. Optional — Aeris routes and talks without one, and says so on screen.
# "auto" tries a local Ollama first (free), then Anthropic if a key is set below.
AERIS_LLM=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Web research. Optional. Without it, research_web says so out loud.
AERIS_WEB_SEARCH=duckduckgo

PORT=4719
