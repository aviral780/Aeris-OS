# Aeris — secrets. gitignored, chmod 600. Never read by the browser.
# The Python server holds these; the page only ever sees text and audio bytes.

ELEVENLABS_API_KEY=

# Voice. Default is Jessica — young, warm, confident.
# Audition and switch live from the UI (gear icon) — it writes back here.
#   Jessica  cgSgspJ2msm6clMCkdW9   sweet + confident, American      <- default
#   Lily     pFZP5JQG7iQjIQuC4Bku   warm, British, steady
#   Alice    Xb7hH8MSUJpSbSDYk0k2   crisp, British, very confident
#   Matilda  XrExE9yKIg1WjnnlVkGX   soft, friendly, American
#   Sarah    EXAVITQu4vr4xnSDxMaL   gentle, low, American
#   Laura    FGY2WhTYpPnrIDTdsKH5   bright, upbeat, American
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# Voice character. 0..1 each.
ELEVENLABS_STABILITY=0.42
ELEVENLABS_SIMILARITY=0.80
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEED=1.03

# 1 = invented fixtures, safe to screen-record.  0 = your real folders.
# Read in exactly one file: agent/data.py
AERIS_DEMO=1

# Your real folders, used only when AERIS_DEMO=0. Colon-separated. Read-only.
AERIS_VAULT_ROOTS=

# ---------------------------------------------------------------- the brain
# "auto" uses whatever is reachable, cheapest first. All three are tried:
#
#   ollama      local, free, fast, and the weakest reasoning
#   claude_cli  the `claude` command you already have. FREE — it runs on your
#               Claude subscription, so a turn costs nothing extra. This is
#               the one that makes Aeris good without making her metered.
#   anthropic   ANTHROPIC_API_KEY. PAID, per token, and billed SEPARATELY
#               from your subscription. Leave it blank to stay free.
#
# Routine turns prefer Ollama for speed; thinking prefers Claude.
AERIS_LLM=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
CLAUDE_CLI=claude
CLAUDE_CLI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------- the voice
# Both default to the free local option when it is available.
#
#   AERIS_TTS=auto|macos|elevenlabs|off
#     macos       the `say` command. Free, instant, no setup. Better voices
#                 are a download away in System Settings > Accessibility >
#                 Spoken Content > System Voice > Manage Voices.
#     elevenlabs  much better, and billed per character.
#
#   AERIS_STT=auto|whisper|elevenlabs|off
#     whisper     free and local, and genuinely excellent on Apple Silicon.
#                 Needs: brew install whisper-cpp ffmpeg, then point
#                 WHISPER_MODEL at a downloaded ggml model file.
#     elevenlabs  Scribe. Metered.
AERIS_TTS=auto
AERIS_STT=auto
MACOS_VOICE=Samantha
MACOS_RATE=
WHISPER_BIN=
WHISPER_MODEL=
WHISPER_LANGUAGE=en

# --------------------------------------------------------------- her hands
# Folders Aeris may write in, colon-separated. Empty means she writes nothing
# and says so. Everything she overwrites is copied into .aeris-backups/ first,
# and every action is appended to Aeris/audit/actions.jsonl.
#
# Deleting, running commands, and touching .env or agent/ always stop and ask,
# whatever is set here.
AERIS_WRITE_ROOTS=

# Web research. Optional. Without it, research_web says so out loud.
AERIS_WEB_SEARCH=duckduckgo

PORT=4719
